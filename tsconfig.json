{
  "compilerOptions": {
    "target": "es2020",
    "module": "nodenext",

    "sourceMap": true,
    "skipLibCheck": true,
    "strictFunctionTypes": false,
    "strictNullChecks": false,
    "noImplicitAny": false,
    "noImplicitThis": false,
    "useUnknownInCatchVariables": false,

    "outDir": "out",
    "alwaysStrict": true,
    "lib": [
      "dom",
      "es2019"
    ],
    
    "rootDir": ".",
    "plugins": [
      {
        "name": "eslint"
      }
    ],
    "types": ["node", "vscode", "mocha"]
  },
  "exclude": [
    "node_modules",
    ".vscode-test"
  ]
}
